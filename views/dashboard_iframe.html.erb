    <style>
      .cluster-monitor-iframe {
        width: 100%;
        height: 100px;
        border: none;
        margin-top: -1.5REM; /*Override spacing above iframe*/
      }

      #main_container{
        max-width:1400px; /*Override iframe parent container max width*/
      }
    </style>

<iframe src="/pun/sys/tufts-systemstatus" class="cluster-monitor-iframe" id="cluster-monitor-iframe" onload="resizeIframe(this)" onresize="resizeIframe(this)" >
</iframe>

<script>
const iframe = document.getElementById("cluster-monitor-iframe");
iframe.addEventListener("load", function() {
  resizeIframe( document.getElementById('cluster-monitor-iframe') );

  setTimeout(function() {
          resizeIframe( document.getElementById('cluster-monitor-iframe') );
  }, 1000);
});

window.addEventListener('resize', (event) => {
    resizeIframe( document.getElementById('cluster-monitor-iframe') );
});

function resizeIframe(obj) {
    obj.style.height = obj.contentWindow.document.body.scrollHeight + 'px';
}
</script>
